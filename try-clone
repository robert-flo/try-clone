#!/usr/bin/env bash
# Clone GitHub repos into a try workspace.
set -euo pipefail

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$SCRIPT_DIR" == "${BASH_SOURCE[0]}" ]]; then
  SCRIPT_DIR="."
fi
OWNERS=(robert-flo 25asab015-forks)
TRY_PATH="${TRY_PATH:-$HOME/Work/tries}"
TRY_CLONE_CONFIG="${TRY_CLONE_CONFIG:-$HOME/.config/try-clone/projects.conf}"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" > /dev/null 2>&1 || die "Missing $1."
}

need gh
need try

gh auth status > /dev/null 2>&1 || die "gh is not logged in. Run: gh auth login"

try_bin="$(type -P try 2> /dev/null || true)"
[[ -n "$try_bin" ]] || die "try is not on PATH."

eval "$("$try_bin" init "$TRY_PATH")"
declare -F try > /dev/null || die "try init did not register a shell function."

mkdir -p "$TRY_PATH"

declare -A PROJECT_MAP=()

load_projects_config() {
  local config_source="$1"
  local line="" trimmed="" project="" repos_str="" repo="" clean_repo=""
  local -a repo_array=()

  if [[ ! -f "$config_source" ]]; then
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line%%#*}"
    trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -z "$trimmed" ]] && continue
    [[ "$trimmed" != *"="* ]] && continue

    project="${trimmed%%=*}"
    project="${project#"${project%%[![:space:]]*}"}"
    project="${project%"${project##*[![:space:]]}"}"

    repos_str="${trimmed#*=}"
    IFS=',' read -r -a repo_array <<< "$repos_str"
    for repo in "${repo_array[@]}"; do
      clean_repo="${repo#"${repo%%[![:space:]]*}"}"
      clean_repo="${clean_repo%"${clean_repo##*[![:space:]]}"}"
      clean_repo="${clean_repo##*/}"
      [[ -n "$clean_repo" ]] && PROJECT_MAP["$clean_repo"]="$project"
    done
  done < "$config_source"
}

init_projects_config() {
  if [[ -f "$TRY_CLONE_CONFIG" ]]; then
    load_projects_config "$TRY_CLONE_CONFIG"
  elif [[ -f "${SCRIPT_DIR}/projects.conf" ]]; then
    load_projects_config "${SCRIPT_DIR}/projects.conf"
  fi
}

slug_for() {
  local full_name="$1"
  local is_fork="$2"
  local repo_name=""
  local prefix="rf-"

  repo_name="${full_name##*/}"
  [[ "$is_fork" == "true" ]] && prefix="fo-"
  printf '%s\n' "${prefix}${repo_name}"
}

project_for() {
  local full_name="$1"
  local repo_name=""
  repo_name="${full_name##*/}"
  printf '%s\n' "${PROJECT_MAP["$repo_name"]:-}"
}

resolve_rel_path() {
  local full_name="$1"
  local is_fork="$2"
  local slug=""
  local project=""

  slug="$(slug_for "$full_name" "$is_fork")"
  project="$(project_for "$full_name")"

  if [[ -n "$project" ]]; then
    printf '%s/%s\n' "$project" "$slug"
  else
    printf '%s\n' "$slug"
  fi
}

list_repos() {
  gh repo list "$1" --limit 1000 \
    --json nameWithOwner,isFork,isPrivate \
    --jq '.[] | [.nameWithOwner, (.isFork|tostring), (.isPrivate|tostring)] | @tsv'
}

init_projects_config

ok=0
skip=0
fail=0
total=0

for owner in "${OWNERS[@]}"; do
  while IFS=$'\t' read -r full_name is_fork is_private; do
    [[ -z "$full_name" ]] && continue
    ((++total))

    rel_path="$(resolve_rel_path "$full_name" "$is_fork")"
    dest="${TRY_PATH}/${rel_path}"
    uri="git@github.com:${full_name}.git"

    if [[ -d "${dest}/.git" ]]; then
      printf 'SKIP  %s  (%s)\n' "$full_name" "$dest"
      ((++skip))
      continue
    fi

    printf 'TRY   %s  private=%s fork=%s  ->  %s\n' \
      "$full_name" "$is_private" "$is_fork" "$rel_path"

    if try clone "$uri" "$rel_path"; then
      ((++ok))
    else
      printf 'FAIL  %s\n' "$full_name" >&2
      ((++fail))
    fi
  done < <(list_repos "$owner")
done

printf 'Done. listed=%s cloned=%s skipped=%s failed=%s\n' "$total" "$ok" "$skip" "$fail"
printf 'Directory: %s\n' "$TRY_PATH"
printf 'Open the picker with: try\n'
exit "$fail"
